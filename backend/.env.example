# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL=postgresql://medtrade:medtrade123@localhost:5432/medtrade

# JWT
JWT_SECRET=change_me_in_production_use_strong_random_string
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRES_SECONDS=2592000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin Secret Key (for creating admins via secret endpoint)
ADMIN_SECRET_KEY=super_secret_admin_key_change_in_production

# Gmail (for sending emails)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Google Cloud Storage
GCS_BUCKET_NAME=24rx-documents

# SMS (Twilio example)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Hold Auto-delivery (days)
HOLD_AUTO_DELIVERY_DAYS=10

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
