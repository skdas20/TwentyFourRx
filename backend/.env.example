# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL=postgresql://medtrade:medtrade123@localhost:5432/medtrade

# JWT
JWT_SECRET=change_me_in_production_use_strong_random_string
JWT_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3
S3_BUCKET=medtrade-files
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (SendGrid example)
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=
EMAIL_FROM=noreply@medtrade.com

# SMS (Twilio example)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Hold Auto-delivery (days)
HOLD_AUTO_DELIVERY_DAYS=10

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
