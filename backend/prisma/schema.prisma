// B2B Medicine Trading Platform - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====
enum UserStatus {
  
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  CREATED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderType {
  BUY
  SELL
}

enum MarkupType {
  PERCENTAGE
  FIXED
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  CANCELLED
}

enum Channel {
  EMAIL
  SMS
  INAPP
}

enum ProposalStatus {
  AWAITING_PAYMENT
  AWAITING_SELLER_INVOICE  // NEW - buyer paid, awaiting seller invoice
  PENDING
  AWAITING_SELLER      // NEW - awaiting seller confirmation
  SELLER_CONFIRMED     // NEW - seller confirmed, awaiting admin
  QUANTITY_MODIFIED    // NEW - seller reduced qty, awaiting buyer approval
  APPROVED
  REJECTED
}

enum DeliveryRequestStatus {
  AWAITING_SELLER           // Seller needs to upload receipt and confirm
  AWAITING_COURIER_PICKUP   // Courier needs to pick up
  IN_TRANSIT                // Courier has picked up, in transit
  OUT_FOR_DELIVERY          // Courier is out for delivery
  DELIVERY_ATTEMPTED        // Delivery was attempted but failed
  PENDING                   // Admin needs to approve
  APPROVED                  // (Legacy - not used in new flow)
  REJECTED
  DISPATCHED                // OTP sent to buyer (legacy)
  PENDING_OTP_VERIFICATION  // Waiting for buyer OTP confirmation
  DELIVERED                 // Buyer confirmed with OTP
  CANCELLED                 // Delivery cancelled
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ===== MODELS =====
model Role {
  code  String @id @db.VarChar(32)
  name  String
  users User[]
}

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String     @unique @db.Citext
  phone     String?
  password  String
  roleCode  String     @map("role_code") @db.VarChar(32)
  status    UserStatus @default(PENDING)
  dlNumber  String?    @map("dl_number")
  gstin     String?    @map("gstin")
  address   String?    @map("address")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  role                    Role                   @relation(fields: [roleCode], references: [code])
  kycDocuments            KycDocument[]
  listings                Listing[]
  orders                  Order[]
  holds                   Hold[]
  inventoryLots           InventoryLot[]
  newsArticles            NewsArticle[]
  notifications           Notification[]
  proposals               MedicineProposal[]
  buyProposals            BuyProposal[]
  reviewedDocuments       KycDocument[]          @relation("ReviewedBy")
  watchlists              Watchlist[]
  priceAlerts             PriceAlert[]
  passwordResetTokens     PasswordResetToken[]
  deliveryRequests        DeliveryRequest[]
  courierDeliveries       DeliveryRequest[]      @relation("CourierDeliveries")
  contributedMedicines    MedicineContribution[] @relation("ContributedMedicines")
  reviewedContributions   MedicineContribution[] @relation("ReviewedContributions")
  supportTickets          SupportTicket[]
  bulkListingRequests     BulkListingRequest[]

  @@index([roleCode])
  @@index([status])
  @@map("users")
}

model KycDocumentType {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String        @unique
  label      String
  isRequired Boolean       @default(false) @map("is_required")
  documents  KycDocument[]

  @@map("kyc_document_types")
}

model KycDocument {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  docTypeId    String     @map("doc_type_id") @db.Uuid
  fileUrl      String     @map("file_url")
  status       DocStatus  @default(PENDING)
  reviewerNote String?    @map("reviewer_note")
  uploadedAt   DateTime   @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  reviewedAt   DateTime?  @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy   String?    @map("reviewed_by") @db.Uuid

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType  KycDocumentType   @relation(fields: [docTypeId], references: [id])
  reviewer User?             @relation("ReviewedBy", fields: [reviewedBy], references: [id])

  @@unique([userId, docTypeId], name: "uq_kyc_user_doc")
  @@index([status])
  @@map("kyc_documents")
}

model Manufacturer {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  country   String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  medicines Medicine[]

  @@unique([name, country])
  @@map("manufacturers")
}

model Marketer {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  country   String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  medicines Medicine[]

  @@unique([name, country])
  @@map("marketers")
}

model Medicine {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  genericName    String?            @map("generic_name")
  composition    String?
  form           String
  strength       String
  packSize       String?            @map("pack_size")
  mrp            Decimal?           @db.Decimal(14, 2)
  manufacturerId String             @map("manufacturer_id") @db.Uuid
  marketerId     String?            @map("marketer_id") @db.Uuid
  imageUrl       String?            @map("image_url") // Medicine photo URL
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  manufacturer      Manufacturer        @relation(fields: [manufacturerId], references: [id])
  marketer          Marketer?           @relation(fields: [marketerId], references: [id])
  listings          Listing[]
  priceHistory      PriceHistory[]
  inventoryLots     InventoryLot[]
  newsMedicines     NewsMedicine[]
  proposals         MedicineProposal[]
  analyticsRollups  AnalyticsRollup[]
  watchlists        Watchlist[]
  priceAlerts       PriceAlert[]

  @@unique([name, form, strength, manufacturerId], name: "uq_medicine")
  @@index([manufacturerId])
  @@index([marketerId])
  @@index([isActive])
  @@index([genericName])
  @@index([composition])
  @@map("medicines")
}

model Listing {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicineId      String        @map("medicine_id") @db.Uuid
  sellerId        String        @map("seller_id") @db.Uuid
  basePrice       Decimal       @map("base_price") @db.Decimal(14, 2)
  proposedMrp     Decimal?      @map("proposed_mrp") @db.Decimal(14, 2) // Seller's proposed MRP for admin review
  adminMarkupType MarkupType?   @default(PERCENTAGE) @map("admin_markup_type") // PERCENTAGE or FIXED
  adminMarkupPct  Decimal       @default(0) @map("admin_markup_pct") @db.Decimal(6, 2) // Percentage or fixed amount
  listPrice       Decimal?      @map("list_price") @db.Decimal(14, 2)
  gstPercentage   Decimal       @default(0) @map("gst_percentage") @db.Decimal(5, 2) // GST percentage: 0 or 5
  stock           Int
  batchNo         String?       @map("batch_no") // Batch number for verification
  expiryDate      DateTime?     @map("expiry_date") @db.Date // Expiry date for verification
  status          ListingStatus @default(PENDING)
  reviewerNote    String?       @map("reviewer_note")
  documentUrl     String?       @map("document_url") // Credibility document (invoice/receipt)
  productImageUrl String?       @map("product_image_url") // Watermarked medicine photo
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt      DateTime?     @map("approved_at") @db.Timestamptz(6)
  activatedAt     DateTime?     @map("activated_at") @db.Timestamptz(6)

  medicine     Medicine      @relation(fields: [medicineId], references: [id])
  seller       User          @relation(fields: [sellerId], references: [id])
  orders       Order[]
  holds        Hold[]
  buyProposals BuyProposal[]

  @@index([medicineId])
  @@index([sellerId])
  @@index([status])
  @@map("listings")
}

model PriceHistory {
  medicineId String   @map("medicine_id") @db.Uuid
  day        DateTime @db.Date
  minPrice   Decimal  @map("min_price") @db.Decimal(14, 2)
  maxPrice   Decimal  @map("max_price") @db.Decimal(14, 2)
  avgPrice   Decimal  @map("avg_price") @db.Decimal(14, 2)

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([medicineId, day])
  @@index([day])
  @@map("price_history")
}

model Order {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId     String      @map("buyer_id") @db.Uuid
  listingId   String      @map("listing_id") @db.Uuid
  qty         Int
  unitPrice   Decimal     @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal?    @db.Decimal(16, 2)
  type        OrderType
  status      OrderStatus @default(CREATED)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt      DateTime?   @map("paid_at") @db.Timestamptz(6)
  deliveredAt DateTime?   @map("delivered_at") @db.Timestamptz(6)
  invoiceUrl  String?     @map("invoice_url")

  buyer            User           @relation(fields: [buyerId], references: [id])
  listing          Listing        @relation(fields: [listingId], references: [id])
  hold             Hold?
  inventoryLots    InventoryLot[]
  approvedProposal BuyProposal?

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Hold {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  traderId         String     @map("trader_id") @db.Uuid
  listingId        String     @map("listing_id") @db.Uuid
  qty              Int
  paidAmount       Decimal    @map("paid_amount") @db.Decimal(16, 2)
  holdStartAt      DateTime   @default(now()) @map("hold_start_at") @db.Timestamptz(6)
  autoDeliveryAt   DateTime   @map("auto_delivery_at") @db.Timestamptz(6)
  status           HoldStatus @default(ACTIVE)
  convertedOrderId String?    @unique @map("converted_order_id") @db.Uuid

  trader         User     @relation(fields: [traderId], references: [id])
  listing        Listing  @relation(fields: [listingId], references: [id])
  convertedOrder Order?   @relation(fields: [convertedOrderId], references: [id])

  @@index([traderId])
  @@index([listingId])
  @@index([status])
  @@index([autoDeliveryAt])
  @@map("holds")
}

model InventoryLot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  medicineId    String   @map("medicine_id") @db.Uuid
  qty           Int
  unitCost      Decimal  @map("unit_cost") @db.Decimal(14, 2)
  sourceOrderId String?  @map("source_order_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id])
  medicine         Medicine          @relation(fields: [medicineId], references: [id])
  sourceOrder      Order?            @relation(fields: [sourceOrderId], references: [id])
  deliveryRequests DeliveryRequest[]

  @@index([userId, medicineId])
  @@map("inventory_lots")
}

model NewsArticle {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  slug          String         @unique
  content       String         @db.Text
  summary       String?        @db.Text // Short summary for card display
  thumbnailUrl  String?        @map("thumbnail_url") // Custom thumbnail or auto-generated
  externalUrl   String?        @map("external_url") // Link to external article
  isPublished   Boolean        @default(false) @map("is_published")
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz(6)
  authorAdminId String         @map("author_admin_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  author        User           @relation(fields: [authorAdminId], references: [id])
  newsMedicines NewsMedicine[]

  @@index([isPublished, publishedAt(sort: Desc)])
  @@map("news_articles")
}

model NewsMedicine {
  newsId     String @map("news_id") @db.Uuid
  medicineId String @map("medicine_id") @db.Uuid

  news     NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)
  medicine Medicine    @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([newsId, medicineId])
  @@index([medicineId])
  @@map("news_medicines")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  channel   Channel
  subject   String
  body      String
  meta      Json?
  isRead    Boolean   @default(false) @map("is_read")
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model MedicineProposal {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String         @map("seller_id") @db.Uuid
  name               String
  form               String
  strength           String
  composition        String?        // Medicine composition/salt
  packSize           String?        @map("pack_size") // Pack size (e.g., "10 tablets", "100ml")
  manufacturerName   String         @map("manufacturer_name")
  marketerName       String?        @map("marketer_name")
  proposedMrp        Decimal?       @map("proposed_mrp") @db.Decimal(14, 2) // Proposed MRP for new medicine
  basePrice          Decimal        @map("base_price") @db.Decimal(14, 2)
  stock              Int            @default(100)
  gstPercentage      Decimal        @default(0) @map("gst_percentage") @db.Decimal(5, 2) // GST percentage: 0 or 5
  documentUrl        String?        @map("document_url")
  productImageUrl String?       @map("product_image_url") // Watermarked medicine photo
  status             ProposalStatus @default(PENDING)
  reviewerNote       String?        @map("reviewer_note")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedMedicineId String?        @map("approved_medicine_id") @db.Uuid

  seller           User      @relation(fields: [sellerId], references: [id])
  approvedMedicine Medicine? @relation(fields: [approvedMedicineId], references: [id])

  @@index([status])
  @@index([sellerId])
  @@map("medicine_proposals")
}

model AnalyticsRollup {
  day           DateTime @db.Date
  medicineId    String   @map("medicine_id") @db.Uuid
  boughtQty     Int      @default(0) @map("bought_qty")
  heldQty       Int      @default(0) @map("held_qty")
  newsMentions  Int      @default(0) @map("news_mentions")
  listedCount   Int      @default(0) @map("listed_count")

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([day, medicineId])
  @@map("analytics_rollups")
}

model MedicineReference {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  genericName     String?  @map("generic_name")
  composition     String
  form            String
  strength        String
  manufacturer    String
  marketer        String?
  packSize        String?  @map("pack_size")
  mrp             Decimal? @db.Decimal(14, 2)  // Maximum Retail Price
  imageUrl        String?  @map("image_url")   // Product image URL from GCS

  // Scraping metadata
  source          String   @default("user_contributed") // "1mg", "pharmeasy", "cdsco", "user_contributed"
  sourceId        String?  @map("source_id")
  lastScrapedAt   DateTime @default(now()) @map("last_scraped_at") @db.Timestamptz(6)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([name, form, strength, manufacturer], name: "uq_medicine_ref")
  @@index([name])
  @@index([genericName])
  @@index([composition])
  @@map("medicine_references")
}

// Medicine contributions pending admin approval
model MedicineContribution {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contributorId   String             @map("contributor_id") @db.Uuid
  name            String
  genericName     String?            @map("generic_name")
  composition     String
  form            String
  strength        String
  manufacturer    String
  marketer        String?
  packSize        String?            @map("pack_size")
  mrp             Decimal?           @db.Decimal(14, 2)
  imageUrl        String?            @map("image_url")
  status          ContributionStatus @default(PENDING)
  reviewerNote    String?            @map("reviewer_note")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy      String?            @map("reviewed_by") @db.Uuid

  contributor User @relation("ContributedMedicines", fields: [contributorId], references: [id])
  reviewer    User? @relation("ReviewedContributions", fields: [reviewedBy], references: [id])

  @@index([contributorId])
  @@index([status])
  @@map("medicine_contributions")
}

// Watchlist for users to track medicines they're interested in
model Watchlist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  medicineId String   @map("medicine_id") @db.Uuid
  name       String?  // Optional custom watchlist name (e.g., "Antibiotics", "Critical Care")
  color      String?  // Color tag for visual organization
  sortOrder  Int      @default(0) @map("sort_order") // For drag-drop ordering
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([userId, medicineId], name: "uq_watchlist_user_medicine")
  @@index([userId])
  @@index([medicineId])
  @@map("watchlists")
}

// Price alerts for users to get notified when price conditions are met
model PriceAlert {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  medicineId    String    @map("medicine_id") @db.Uuid
  targetPrice   Decimal   @map("target_price") @db.Decimal(14, 2)
  condition     String    // "BELOW", "ABOVE", "EQUALS"
  isActive      Boolean   @default(true) @map("is_active")
  triggeredAt   DateTime? @map("triggered_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([medicineId])
  @@index([isActive])
  @@map("price_alerts")
}

// Password reset tokens for secure password reset flow
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique // Hashed token
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Buy proposals for admin approval (with receipt upload)
model BuyProposal {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId         String         @map("buyer_id") @db.Uuid
  listingId       String         @map("listing_id") @db.Uuid
  qty             Int
  orderType       String         @map("order_type") // "delivery", "intraday", "mtf"
  receiptUrl      String?        @map("receipt_url") // Uploaded receipt/proof
  sellerInvoiceUrl String?       @map("seller_invoice_url") // Invoice uploaded by seller
  notes           String?        // Optional notes from buyer
  status          ProposalStatus @default(PENDING)
  reviewerNote    String?        @map("reviewer_note")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  approvedOrderId String?        @unique @map("approved_order_id") @db.Uuid

  // NEW: Seller confirmation fields
  sellerConfirmedAt    DateTime?  @map("seller_confirmed_at") @db.Timestamptz(6)
  sellerNote           String?    @map("seller_note")
  confirmedQty         Int?       @map("confirmed_qty")
  confirmedBatchNo     String?    @map("confirmed_batch_no")
  confirmedExpiryDate  DateTime?  @map("confirmed_expiry_date") @db.Date

  // NEW: Timeout tracking
  sellerReminderSentAt DateTime?  @map("seller_reminder_sent_at") @db.Timestamptz(6)
  sellerTimeoutAt      DateTime?  @map("seller_timeout_at") @db.Timestamptz(6)

  // NEW: Flow type identifier
  flowType             String     @default("LEGACY") @map("flow_type") // "LEGACY" or "SELLER_CONFIRMATION"

  buyer         User     @relation(fields: [buyerId], references: [id])
  listing       Listing  @relation(fields: [listingId], references: [id])
  approvedOrder Order?   @relation(fields: [approvedOrderId], references: [id])

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
  @@map("buy_proposals")
}

// Physical delivery requests from sellers/traders for their inventory
model DeliveryRequest {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId         String                @map("requester_id") @db.Uuid
  inventoryLotId      String                @map("inventory_lot_id") @db.Uuid
  qty                 Int
  status              DeliveryRequestStatus @default(PENDING)
  reviewerNote        String?               @map("reviewer_note")
  invoiceUrl          String?               @map("invoice_url")
  packageImageUrl     String?               @map("package_image_url") // Package photo uploaded by seller
  trackingNumber      String?               @map("tracking_number")
  deliveryPartner     String?               @map("delivery_partner")
  deliveryOtp         String?               @map("delivery_otp") @db.VarChar(6)
  otpExpiresAt        DateTime?             @map("otp_expires_at") @db.Timestamptz(6)
  otpVerifiedAt       DateTime?             @map("otp_verified_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt          DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  dispatchedAt        DateTime?             @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt         DateTime?             @map("delivered_at") @db.Timestamptz(6)
  
  // NEW: Courier system fields
  assignedCourierId   String?               @map("assigned_courier_id") @db.Uuid
  courierPickupAt     DateTime?             @map("courier_pickup_at") @db.Timestamptz(6)
  estimatedDeliveryAt DateTime?             @map("estimated_delivery_at") @db.Timestamptz(6)
  deliveryProofUrl    String?               @map("delivery_proof_url") // Photo at delivery
  courierNotes        String?               @map("courier_notes") @db.Text

  requester       User              @relation(fields: [requesterId], references: [id])
  inventoryLot    InventoryLot      @relation(fields: [inventoryLotId], references: [id])
  assignedCourier User?             @relation("CourierDeliveries", fields: [assignedCourierId], references: [id])
  supportTickets  SupportTicket[]

  @@index([requesterId])
  @@index([inventoryLotId])
  @@index([status])
  @@index([assignedCourierId])
  @@index([status, assignedCourierId])
  @@map("delivery_requests")
}

// Support tickets for delivery issues
model SupportTicket {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  deliveryRequestId String?  @map("delivery_request_id") @db.Uuid
  subject           String
  message           String   @db.Text
  status            String   @default("OPEN") @db.VarChar(20)
  adminResponse     String?  @map("admin_response") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)

  user            User              @relation(fields: [userId], references: [id])
  deliveryRequest DeliveryRequest?  @relation(fields: [deliveryRequestId], references: [id])

  @@index([userId])
  @@index([deliveryRequestId])
  @@index([status])
  @@map("support_tickets")
}

